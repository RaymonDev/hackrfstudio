/* HackRF Studio Modern Dark SDR Theme */

QWidget {
    background-color: #1a1c1e;
    color: #e2e8f0;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 11px;
}

QMainWindow {
    background-color: #121316;
}

QGroupBox {
    border: 1px solid #2d3748;
    border-radius: 6px;
    margin-top: 18px;
    font-weight: bold;
    color: #00ffaa;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

QPushButton {
    background-color: #2b303c;
    color: #e2e8f0;
    border: 1px solid #3d4554;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3b4252;
    border-color: #00e6c3;
}

QPushButton:pressed {
    background-color: #1f232b;
}

QPushButton:disabled {
    background-color: #1b1e24;
    color: #555e6d;
    border-color: #262a33;
}

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #111317;
    color: #00f0ff;
    border: 1px solid #2d3748;
    border-radius: 4px;
    padding: 3px 6px;
    font-family: "Consolas", monospace;
    font-size: 12px;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border: 1px solid #00ffaa;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #242933;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #00b4d8;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00ffaa;
    border: 1px solid #121316;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QTabWidget::pane {
    border: 1px solid #2d3748;
    background-color: #16181d;
    border-radius: 4px;
}

QTabBar::tab {
    background: #1e222a;
    color: #8b9bb4;
    border: 1px solid #2d3748;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #16181d;
    color: #00ffaa;
    border-color: #00e6c3;
    border-bottom: 2px solid #16181d;
}

QTableWidget {
    background-color: #111317;
    color: #e2e8f0;
    gridline-color: #262c38;
    border: 1px solid #2d3748;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: #1e222a;
    color: #00ffaa;
    padding: 4px;
    border: 1px solid #2d3748;
    font-weight: bold;
}

QStatusBar {
    background-color: #0f1013;
    color: #8892b0;
    border-top: 1px solid #222630;
}

QStatusBar QLabel {
    font-family: "Consolas", monospace;
    padding: 0 8px;
}
